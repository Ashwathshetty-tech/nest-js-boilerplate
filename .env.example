# Copy this file to .env and adjust values before running services
PORT=3000

# MongoDB
MONGODB_URI=mongodb://mongo_db:27017/mydb
MONGODB_DB=mydb

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_HOST=postgres_db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379

# Rate limiter
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
